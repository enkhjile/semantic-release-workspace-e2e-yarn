{
  "name": "semantic-release-workspace-e2e-yarn",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "live/*"
  ],
  "scripts": {
    "test": "node scripts/build-live.mjs && node --test scripts/*.test.mjs",
    "release:live": "semantic-release",
    "build": "node scripts/build-live.mjs"
  },
  "devDependencies": {
    "@semantic-release/github": "12.0.10",
    "@yarnpkg/cli-dist": "4.18.1",
    "semantic-release": "25.0.9",
    "semantic-release-workspace": "1.0.0-alpha.10"
  }
}
